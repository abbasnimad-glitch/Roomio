# Supabase — get these from your Supabase project's Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Maps — get from Google Cloud Console (enable Maps JavaScript API + Places API)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Boost Payment — Stripe (server-only; leave unset and the Stripe option
# on the boost payment page will show a clear "not configured" error,
# PromptPay still works without it)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Error monitoring — Sentry (DSN required to capture errors; leave unset to disable)
NEXT_PUBLIC_SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0
# Only needed in CI to upload source maps — safe to leave unset for local dev
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Analytics (optional — leave unset to disable either provider)
# Google Analytics 4 — Measurement ID from GA4 Admin > Data Streams
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# PostHog — Project API key from Project Settings; host defaults to PostHog Cloud US if unset
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
